# Streamlit secrets: the TOML equivalent of .env.
# Locally: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Community Cloud: paste into the app's Settings -> Secrets box.
# Streamlit copies these top-level keys into environment variables, so
# clarifysql/config.py reads them exactly as it reads .env.

# Hosted database (Neon etc.): set this one line and leave out the DB_* lines.
# DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

DB_NAME = "clarifysql"
DB_USER = "postgres"
DB_PASSWORD = "postgres"
DB_HOST = "localhost"
DB_PORT = "5432"
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "qwen/qwen3.8-27b"
